# Base URL of the MentorLagbe Express API (include the /api prefix)
# This is the ONLY client env var. BETTER_AUTH_SECRET, BETTER_AUTH_URL,
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are server-only secrets and must
# never be added here or in Vercel. Google sign-in availability is discovered
# through GET /api/auth/google/status.
NEXT_PUBLIC_API_URL=http://localhost:5000/api
